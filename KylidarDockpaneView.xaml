<UserControl x:Class="KylidarAddin.KylidarDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="300">
    <!--
      No hardcoded Background/Foreground here (unlike the old BufferInputDialog/ProgressDialog
      windows, which needed explicit colors because standalone Windows sit outside Pro's resource
      dictionaries). This UserControl renders inside Pro's own window, so it picks up Pro's
      light/dark theme automatically through Pro's implicit control styles; explicit colors
      would just fight that and look wrong in dark mode.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <TextBlock Text="Area of Interest" FontWeight="Bold" Margin="0,0,0,4"/>
            <UniformGrid Columns="2" Rows="2">
                <Button Content="Draw Point" Command="{Binding DrawPointCommand}" Margin="2" Padding="6,3"/>
                <Button Content="Draw Line" Command="{Binding DrawLineCommand}" Margin="2" Padding="6,3"/>
                <Button Content="Draw Polygon" Command="{Binding DrawPolygonCommand}" Margin="2" Padding="6,3"/>
                <Button Content="Select Feature" Command="{Binding SelectFeatureCommand}" Margin="2" Padding="6,3"/>
            </UniformGrid>
            <Button Content="Clear Selection" Command="{Binding ClearAoiCommand}" HorizontalAlignment="Left" Margin="2,4,2,0" Padding="6,3"/>
            <TextBlock Text="{Binding AoiStatusText}" TextWrapping="Wrap" Margin="0,4,0,12"/>

            <Separator Margin="0,0,0,12"/>

            <TextBlock Text="LiDAR phase(s):" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox Content="Phase 1" IsChecked="{Binding Phase1}" IsEnabled="False" Margin="0,0,10,0"
                          ToolTip="Phase 1 is in regular LAZ format and should be downloaded using the kyfromabove-stac add-in tool."/>
                <CheckBox Content="Phase 2" IsChecked="{Binding Phase2}" Margin="0,0,10,0"/>
                <CheckBox Content="Phase 3" IsChecked="{Binding Phase3}"/>
            </StackPanel>

            <Button Content="Search Catalog" Command="{Binding SearchCatalogCommand}" HorizontalAlignment="Left" Padding="10,3" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding CatalogSearchStatusText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding SearchHitLimit, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Search limit:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="70" Text="{Binding SearchLimitText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                <TextBlock Text="Raise this, then click Search Catalog (or Run/Export Script) again." VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0,0,0"/>
            </StackPanel>

            <Separator Margin="0,0,0,12"/>

            <TextBlock Text="Output" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <CheckBox Content="{Binding DownloadCopcOnlyLabel}" IsChecked="{Binding IsDownloadCopcOnlySelected}" VerticalAlignment="Center"/>
                    <Button Content="i" Style="{StaticResource InfoButtonStyle}"
                            ToolTip="Fastest, least disk space: downloads the raw COPC/LAZ tile(s) as-is. No clipping or conversion -- you get compressed source files, not ready-to-use .las."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <CheckBox Content="Download &amp; Convert to LAS" IsChecked="{Binding IsConvertKeepCopcSelected}" VerticalAlignment="Center"/>
                    <Button Content="i" Style="{StaticResource InfoButtonStyle}"
                            ToolTip="Downloads the raw tile(s) AND converts to .las, keeping both (in separate COPC and LAS subfolders). Most disk space, but the raw tiles are on hand again without re-downloading."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Download, Convert to LAS, Discard COPC" IsChecked="{Binding IsConvertDiscardCopcSelected}" VerticalAlignment="Center"/>
                    <Button Content="i" Style="{StaticResource InfoButtonStyle}"
                            ToolTip="Downloads the raw tile(s), converts to .las, then deletes the raw copies. Least disk space of the conversion options, but you'd need to re-download the raw tile(s) if wanted again."/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                <CheckBox Content="Clip to area of interest" IsChecked="{Binding ClipToAoi}" VerticalAlignment="Center"/>
                <Button Content="i" Style="{StaticResource InfoButtonStyle}"
                        ToolTip="Crops every tile down to the AOI (plus the buffer below) using PDAL during conversion. Can significantly increase processing time, especially for large AOIs or many tiles."/>
            </StackPanel>
            <Grid Margin="0,0,0,2" Visibility="{Binding ShowBufferSettings, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Buffer (feet):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding BufferFeetText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <TextBlock Text="Warning: polygons with holes, gaps, or islands can cause the Run process to error when clipping is enabled." Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding ShowAoiClipComplexityWarning, Converter={StaticResource BoolToVis}}"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" Padding="8,3"/>
            </Grid>

            <Separator Margin="0,0,0,12"/>

            <TextBlock Text="Add to LAS Dataset" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Margin="0,0,0,4">
                <CheckBox Content="None" IsChecked="{Binding IsDatasetActionNoneSelected}" Margin="0,0,0,2"/>
                <CheckBox Content="Create new dataset" IsChecked="{Binding IsDatasetActionCreateNewSelected}" Margin="0,0,0,2"/>
                <CheckBox Content="Add to existing dataset" IsChecked="{Binding IsDatasetActionAddExistingSelected}"/>
            </StackPanel>

            <Grid Margin="0,0,0,6" Visibility="{Binding ShowNewDatasetPath, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding NewDatasetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseNewDatasetCommand}" Padding="8,3"/>
            </Grid>

            <Grid Margin="0,0,0,6" Visibility="{Binding ShowExistingDatasetPath, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ExistingDatasetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseExistingDatasetCommand}" Padding="8,3"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="Build pyramids (not recommended)" IsChecked="{Binding BuildPyramids}" IsEnabled="{Binding CanBuildPyramids}" VerticalAlignment="Center"/>
                <Button Content="i" Style="{StaticResource InfoButtonStyle}"
                        ToolTip="Speeds up display of the dataset in the map, but can add significantly more time to processing."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="Add hydro-enforced breaklines" IsChecked="{Binding AddBreaklines}" IsEnabled="{Binding CanAddBreaklines}" VerticalAlignment="Center"/>
                <Button Content="i" Style="{StaticResource InfoButtonStyle}"
                        ToolTip="Downloads the KyFromAbove hydro-enforced breaklines inside the AOI (Phase 2 and 3; Phase 1 has no elevation values), clips them to it (the AOI plus buffer when clipping), reprojects to EPSG:3089, and adds them to the LAS dataset as a Hard_Line surface constraint. Needs a polygon AOI, or 'Clip to area of interest' with a buffer. If the download fails, the dataset is still built without them."/>
            </StackPanel>

            <TextBlock Text="{Binding ValidationText}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Run" Command="{Binding RunCommand}" Padding="14,4" Margin="0,0,8,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="14,4" Margin="0,0,8,0"/>
                <Button Content="Export Script..." Command="{Binding ExportScriptCommand}" Padding="14,4"
                        ToolTip="Write a stand-alone download/convert script for the current AOI's tiles, to run without ArcGIS Pro."/>
            </StackPanel>
            <TextBlock Text="{Binding ExportScriptStatusText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="Progress" FontWeight="Bold" Margin="0,0,0,4"/>
            <ListBox ItemsSource="{Binding LogLines}" Height="160" FontFamily="Consolas" FontSize="11" Margin="0,0,0,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Aggregate progress across the whole tile set (tqdm-style), below the scrolling log
                 above rather than making anyone read individual "Downloading X: N MB (P%)" lines to
                 gauge how far along the run is overall. Indeterminate until the STAC search resolves
                 a tile count, then a determinate bar + phase/count/percentage/ETA text. -->
            <ProgressBar Height="14" Margin="0,0,0,2" Minimum="0" Maximum="1" Value="{Binding RunProgressFraction, Mode=OneWay}"
                         Visibility="{Binding ShowRunProgressBar, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding RunProgressText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding ShowRunProgressBar, Converter={StaticResource BoolToVis}}"/>
            <ProgressBar IsIndeterminate="True" Height="14" Margin="0,0,0,10"
                         Visibility="{Binding ShowIndeterminateProgressBar, Converter={StaticResource BoolToVis}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
