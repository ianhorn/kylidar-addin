<Window x:Class="KylidarAddin.ExportScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Script"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <!--
      Standalone Window (unlike KylidarDockpaneView, a UserControl docked inside Pro's own window),
      so it sits outside Pro's resource dictionaries and needs explicit colors: Pro's implicit
      dark-theme ControlTemplates otherwise leave parts of it dark-on-dark. Modeled directly on
      kyfromabove-ext's ExportScriptDialog (same add-in family, same "stand-alone download kit"
      idea), including this same color-handling approach.
    -->
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,10">
            Write out a stand-alone download/convert kit for the current AOI's matching tiles that
            runs without ArcGIS Pro -- for very large batches, running on another machine, or
            scheduling for later. The convert step needs the "pdal" CLI on the machine that runs
            it; LAS dataset creation/pyramids are a Pro-only step and aren't included.
        </TextBlock>

        <TextBlock Grid.Row="1" Text="Script type" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="2" x:Name="FormatButtonsPanel" Orientation="Vertical" Margin="0,0,0,2">
            <Button x:Name="PythonButton" Tag="Python" Content="Python script (.py)" Click="FormatButton_Click"
                    HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,2"
                    Background="#0078D7" Foreground="White" BorderBrush="#0078D7"/>
            <Button x:Name="NotebookButton" Tag="Notebook" Content="Jupyter notebook (.ipynb)" Click="FormatButton_Click"
                    HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,2"
                    Background="White" Foreground="Black" BorderBrush="Gray"/>
            <Button x:Name="PowerShellButton" Tag="PowerShell" Content="PowerShell script (.ps1)" Click="FormatButton_Click"
                    HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,2"
                    Background="White" Foreground="Black" BorderBrush="Gray"/>
            <Button x:Name="ShellButton" Tag="Shell" Content="Shell script (.sh)" Click="FormatButton_Click"
                    HorizontalContentAlignment="Left" Padding="8,4" Margin="0,0,0,2"
                    Background="White" Foreground="Black" BorderBrush="Gray"/>
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="FormatHintText" Foreground="#555555" FontStyle="Italic" FontSize="11" Margin="0,2,0,10"/>

        <TextBlock Grid.Row="4" Text="Downloads will be saved to" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,2"/>
        <Grid Grid.Row="5" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="DestinationBox" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Browse..." Padding="8,2" Click="Browse_Click"/>
        </Grid>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Padding="10,4" Margin="0,0,6,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Export" Padding="10,4" Click="Export_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
