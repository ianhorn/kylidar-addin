<Window x:Class="KylidarAddin.AddApiSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bring Your Own API"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        Ported from kyfromabove-ext's AddApiSourceDialog.xaml (same dialog, same purpose). ArcGIS Pro
        applies its own implicit ControlTemplates to every window in the process, and its ComboBox
        popup chrome ignores locally-set Background/Foreground, unlike this add-in's other dialogs
        (ExportScriptDialog/FeedbackDialog, which get away with plain hardcoded colors because they
        have no ComboBox). The catalog picker below replaces the ComboBox/ComboBoxItem templates
        outright with plain ones whose colors come from the palette brushes below, so it's readable
        regardless of what Pro's theme does. The palette here is the light one; the code-behind swaps
        in the dark one when Pro is in its Dark theme (ProTheme.IsDark).
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="CatalogComboBackground" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CatalogComboForeground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="CatalogComboBorder" Color="#FF8A8A8E"/>
        <SolidColorBrush x:Key="CatalogComboHint" Color="#FF6E6E6E"/>
        <SolidColorBrush x:Key="CatalogComboItemHighlight" Color="#FFCCE4F7"/>
        <SolidColorBrush x:Key="CatalogComboItemSelected" Color="#FFE6E6E6"/>

        <Style x:Key="CatalogComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CatalogComboBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CatalogComboForeground}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CatalogComboItemHighlight}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CatalogComboItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CatalogComboBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource CatalogComboForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CatalogComboBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CatalogComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource CatalogComboBackground}" BorderBrush="{DynamicResource CatalogComboBorder}" BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource CatalogComboForeground}" Margin="0,0,8,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="6,3,24,3" IsHitTestVisible="False"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock x:Name="Hint" Margin="6,3,24,3" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Foreground="{DynamicResource CatalogComboHint}" FontStyle="Italic"
                                       Text="{TemplateBinding Tag}" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Width="{Binding ActualWidth, ElementName=Root}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource CatalogComboBackground}" BorderBrush="{DynamicResource CatalogComboBorder}" BorderThickness="1"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            Point this search UI at another STAC API. You can add it alongside the built-in
            KyFromAbove catalog, or replace the current source list entirely.
        </TextBlock>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#B8860B" FontStyle="Italic" Margin="0,0,0,10">
            &#9888; Experimental: only assets that look like LiDAR point clouds (.las/.laz, by
            filename) are ever downloaded, regardless of API -- but search, collection listing, and
            clipping are still only tested against KyFromAbove's own catalog, and may not work as
            expected with every STAC API.
        </TextBlock>

        <TextBlock Grid.Row="2" Text="Choose a public API from STAC Index" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <ComboBox Grid.Row="3" x:Name="CatalogCombo" Style="{StaticResource CatalogComboStyle}" Margin="0,0,0,4"
                  SelectionChanged="CatalogCombo_SelectionChanged"
                  ToolTip="Fills in the Name and URL below. You can still edit them, or type your own instead.">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="360">
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="4" TextWrapping="Wrap" FontStyle="Italic" FontSize="11" Foreground="#FF808080" Margin="0,0,0,10">
            Lists public catalogs from stacindex.org that expose a searchable STAC API. Catalogs that
            need a login or API key aren't included.
        </TextBlock>

        <TextBlock Grid.Row="5" Text="Name" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox Grid.Row="6" x:Name="NameBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="7" Text="STAC API base URL" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox Grid.Row="8" x:Name="UrlBox" Margin="0,0,0,4"
                 ToolTip="e.g. https://planetarycomputer.microsoft.com/api/stac/v1"/>

        <TextBlock Grid.Row="9" x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Padding="10,4" Margin="0,0,6,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Replace all sources" Padding="10,4" Margin="0,0,6,0" Click="Replace_Click"
                    ToolTip="Remove all current sources and search only this API."/>
            <Button Content="Add" Padding="10,4" Click="Add_Click" IsDefault="True"
                    ToolTip="Keep existing sources and add this one alongside them."/>
        </StackPanel>
    </Grid>
</Window>
