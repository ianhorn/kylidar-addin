<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="KylidarAddin.dll" defaultNamespace="KylidarAddin"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

  <AddInInfo id="{f2cadbcc-46f7-48b0-8cb4-9b56b3eb038d}" version="1.0.0.0" desktopVersion="3.6.0" product="ArcGISPro">
    <Name>Kylidar Add-in</Name>
    <Description>Kylidar Add-in description</Description>
    <Image>Images\AddInDesktop32.png</Image>
    <Author>Ian Horn</Author>
    <Company>Kylidar</Company>
    <Date>9/7/2026</Date>
    <Subject>Framework</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>

  <modules>
    <insertModule id="KylidarAddin_Module" className="Module1" autoLoad="false" caption="Module1">
      <tabs>
        <tab id="KylidarAddin_Tab1" caption="Kylidar" keytip="K0">
          <group refID="KylidarAddin_Group1"/>
        </tab>
      </tabs>

      <groups>
        <group id="KylidarAddin_Group1" caption="LiDAR AOI" appearsOnAddInTab="false" keytip="G1">
          <toolPalette id="KylidarAddin_DrawAoiPalette" size="large" itemsInRow="1">
            <tool refID="KylidarAddin_DrawPointAoiTool"/>
            <tool refID="KylidarAddin_DrawLineAoiTool"/>
            <tool refID="KylidarAddin_DrawPolygonAoiTool"/>
          </toolPalette>
          <button refID="KylidarAddin_ClipLidarButton" size="large"/>
        </group>
      </groups>

      <controls>
        <tool id="KylidarAddin_DrawPointAoiTool" caption="Draw Point AOI" className="DrawPointAoiTool"
              loadOnClick="true" condition="esri_mapping_mapPane"
              smallImage="GenericPoint16" largeImage="GenericPoint32">
          <tooltip heading="Draw Point AOI">Draw a point to use as the LiDAR clip AOI.<disabledText /></tooltip>
        </tool>
        <tool id="KylidarAddin_DrawLineAoiTool" caption="Draw Line AOI" className="DrawLineAoiTool"
              loadOnClick="true" condition="esri_mapping_mapPane"
              smallImage="GenericLine16" largeImage="GenericLine32">
          <tooltip heading="Draw Line AOI">Draw a line to use as the LiDAR clip AOI.<disabledText /></tooltip>
        </tool>
        <tool id="KylidarAddin_DrawPolygonAoiTool" caption="Draw Polygon AOI" className="DrawPolygonAoiTool"
              loadOnClick="true" condition="esri_mapping_mapPane"
              smallImage="GenericPolygon16" largeImage="GenericPolygon32">
          <tooltip heading="Draw Polygon AOI">Draw a polygon to use as the LiDAR clip AOI.<disabledText /></tooltip>
        </tool>
        <button id="KylidarAddin_ClipLidarButton" caption="Clip LiDAR to AOI" className="ClipLidarButton"
                loadOnClick="true" smallImage="Images\AddInDesktop16.png" largeImage="Images\AddInDesktop32.png">
          <tooltip heading="Clip LiDAR to AOI">Search, download, and clip LiDAR point-cloud tiles to the drawn AOI, producing a single .las file.<disabledText /></tooltip>
        </button>
      </controls>

    </insertModule>
  </modules>
</ArcGIS>
